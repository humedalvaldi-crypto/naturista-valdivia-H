# Naturista Valdivia — variables de entorno de ejemplo.
# Copia este archivo a `.env` (o a `worker/.dev.vars` para el Worker) y
# rellena los valores. NUNCA subas los valores reales al repositorio.

# ---------- Firebase (identidad) ----------
# ID del proyecto Firebase. Es público (aparece en la app), pero es por entorno.
FIREBASE_PROJECT_ID=naturista-valdivia-dev

# ---------- Cloudflare Worker (worker/.dev.vars) ----------
# Orígenes permitidos para CORS, separados por comas. Sin comodines en producción.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Entorno: development | staging | production
APP_ENV=development

# ---------- App Flutter (--dart-define) ----------
# URL base de la API. Se pasa con:
#   flutter run --dart-define=API_BASE_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787

# ---------- Migración (solo lectura, máquina local del administrador) ----------
# Ruta a la clave de cuenta de servicio de Firebase. Guárdala FUERA del repo.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/service-account.json
# Carpeta donde se escriben los informes de auditoría (ignorada por git).
MIGRATION_OUTPUT_DIR=migration/output
